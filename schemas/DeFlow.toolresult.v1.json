{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflow.dev/schemas/DeFlow.toolresult.v1.json",
  "title": "DeFlow.toolresult.v1",
  "description": "What a `tool` node of kind `script` produced: its exit, how long it took, and handles to the two streams — never the output itself, which lives in the data plane (F2.1).",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "script"
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "signal": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timedOut": {
      "type": "boolean"
    },
    "stdout": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stderr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "exitCode",
    "signal",
    "durationMs",
    "timedOut",
    "stdout",
    "stderr"
  ],
  "additionalProperties": false
}
