{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflow.dev/schemas/DeFlow.contextpacket.v1.json",
  "title": "DeFlow.contextpacket.v1",
  "description": "The addressable, typed context a node actually received (F6.1, F6.2).",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "DeFlow.contextpacket.v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_\\d{8}T\\d{6}Z_[0-9a-f]{6}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "builtAtEvent": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "target": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "maxContext": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "provider",
        "model",
        "maxContext"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "fraction": {
          "default": 0.5,
          "type": "number",
          "maximum": 0.6
        },
        "limitTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "limitTokens"
      ],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byKind": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "pinned.constraints",
              "pinned.spec",
              "pinned.pathscope",
              "task.brief",
              "fact",
              "artifact.handle",
              "retrieved",
              "history.summary",
              "tool.output"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": [
            "pinned.constraints",
            "pinned.spec",
            "pinned.pathscope",
            "task.brief",
            "fact",
            "artifact.handle",
            "retrieved",
            "history.summary",
            "tool.output"
          ],
          "properties": {
            "pinned.constraints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pinned.spec": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pinned.pathscope": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "task.brief": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "fact": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "artifact.handle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "retrieved": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "history.summary": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tool.output": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "required": [
        "tokens",
        "byKind"
      ],
      "additionalProperties": false
    },
    "renderedPromptHandle": {
      "type": "string"
    },
    "pinnedDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256-[0-9a-f]{64}$"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pinned.constraints",
              "pinned.spec",
              "pinned.pathscope",
              "task.brief",
              "fact",
              "artifact.handle",
              "retrieved",
              "history.summary",
              "tool.output"
            ]
          },
          "sourceEvent": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256-[0-9a-f]{64}$"
          },
          "tokens": {
            "type": "object",
            "properties": {
              "estimated": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "method": {
                "type": "string",
                "enum": [
                  "gpt-tokenizer/o200k_base",
                  "heuristic",
                  "vendor-reported"
                ]
              }
            },
            "required": [
              "estimated",
              "method"
            ],
            "additionalProperties": false
          },
          "pinned": {
            "type": "boolean"
          },
          "compactable": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "sourceEvent",
          "contentHash",
          "tokens",
          "pinned",
          "compactable",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaId",
    "runId",
    "nodeId",
    "attempt",
    "builtAtEvent",
    "target",
    "budget",
    "totals",
    "renderedPromptHandle",
    "pinnedDigests",
    "segments"
  ],
  "additionalProperties": false
}
