{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflow.dev/schemas/DeFlow.humandecision.v1.json",
  "title": "DeFlow.humandecision.v1",
  "description": "What a `human` node returns when the operator chose rather than supplied: the option they picked, what it does, and the words they attached to it (F8.1).",
  "type": "object",
  "properties": {
    "node": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "optionId": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "edit",
        "inject"
      ]
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "node",
    "optionId",
    "effect"
  ],
  "additionalProperties": false
}
