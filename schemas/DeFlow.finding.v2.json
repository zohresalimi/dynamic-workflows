{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflow.dev/schemas/DeFlow.finding.v2.json",
  "title": "DeFlow.finding.v2",
  "description": "A structured gate finding whose line is anchored to the blob it was read from, so a later revision cannot silently redraw it against the wrong line (F7.7).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "major",
        "minor",
        "info"
      ]
    },
    "criterion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "blobSha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "file",
        "line",
        "blobSha"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestedFix": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "severity",
    "message",
    "evidence"
  ],
  "additionalProperties": false
}
