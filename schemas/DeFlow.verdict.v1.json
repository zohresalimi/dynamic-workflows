{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflow.dev/schemas/DeFlow.verdict.v1.json",
  "title": "DeFlow.verdict.v1",
  "description": "A gate verdict: outcome, per-criterion status and structured findings (F7.4).",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "pattern": "^[A-Za-z][\\w.-]*\\.v\\d+$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "needs-human"
      ]
    },
    "gate": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "evaluatedNode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "by": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node",
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "unsatisfied",
              "unverifiable"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "info"
            ]
          },
          "criterion": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "file",
              "line"
            ],
            "additionalProperties": false
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggestedFix": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "message",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  },
  "required": [
    "schemaId",
    "outcome",
    "gate",
    "evaluatedNode",
    "by",
    "criteria",
    "findings",
    "summary"
  ],
  "additionalProperties": false
}
