{
  "name": "deflow-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "DeFlow_DEV=1 node --watch --watch-path=packages/core --watch-path=packages/ledger --watch-path=packages/adapters --watch-path=packages/daemon --watch-path=packages/cli --watch-path=packages/mock-agent packages/daemon/src/main.ts",
    "dev:pretty": "pnpm dev | pino-pretty",
    "dev:replay": "DeFlow_DEV=1 node --watch --watch-path=packages/core --watch-path=packages/ledger --watch-path=packages/daemon --watch-path=packages/web/src packages/daemon/src/replay/main.ts happy-path-12 --speed 20x --port 7777 --dev",
    "build": "node packages/cli/scripts/build.ts",
    "pack:check": "pnpm build && pnpm --filter deflowai exec publint && pnpm --filter deflowai exec attw --pack",
    "verify:install": "node packages/cli/scripts/verify-install/run.ts",
    "typecheck": "tsc -b && pnpm --filter @DeFlow/web exec vue-tsc --noEmit",
    "lint": "oxlint --type-aware && biome check . && pnpm lint:graph-facade && pnpm lint:terminal-facade",
    "lint:graph-facade": "node packages/web/scripts/check-graph-facade.ts",
    "lint:terminal-facade": "node packages/web/scripts/check-terminal-facade.ts",
    "format": "biome check --write .",
    "schemas:emit": "node packages/core/scripts/emit-schemas.ts",
    "schemas:check": "node packages/core/scripts/check-schemas.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:smoke": "vitest run --project smoke",
    "test:fuzz": "vitest run --project crash-fuzz",
    "test:record": "node packages/adapters/scripts/record-goldens.ts",
    "measure:graph": "node packages/web/scripts/measure-graph.ts",
    "measure:diagnosis": "node e2e/support/diagnosis-walk.ts",
    "spike:s3:record": "DeFlow_RECORD_MEASUREMENTS=1 vitest run --project e2e e2e/spike-s3-elk-worker.test.ts && DeFlow_RECORD_MEASUREMENTS=1 node spikes/s3-elk-worker/check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
