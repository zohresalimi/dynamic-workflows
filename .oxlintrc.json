{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint is the linter for the Node packages: core, ledger, adapters,
  // daemon, cli. packages/web is Vue and gets ESLint at M2 (oxlint sees only
  // the <script> block of an SFC). packages/mock-agent and packages/testkit
  // are excluded per docs/16-repo-layout.md — mock-agent is deliberately an
  // independent implementation, and testkit ships fake binaries the type-aware
  // rules below are not aimed at.
  "plugins": ["typescript", "unicorn", "promise", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-argument": "error"
  },
  // R1 / KAR-02.8 AC7: @DeFlow/core is pure, and purity is a property of the
  // build rather than of a test somebody remembered to run. A `node:fs` import
  // under packages/core/src is refused here, in the editor, at the moment it is
  // typed — not at review time. Build tooling that legitimately needs the disk
  // lives in packages/core/scripts (the JSON Schema emitter), which this
  // override does not cover, and which is outside the published surface.
  "overrides": [
    {
      "files": ["packages/core/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*"],
                "message": "@DeFlow/core performs no I/O (R1). Time, randomness and ids enter through ports declared in core and implemented in @DeFlow/daemon or @DeFlow/testkit; the JSON Schema emitter lives in packages/core/scripts."
              }
            ],
            "paths": [
              {
                "name": "better-sqlite3",
                "message": "The ledger's driver belongs in @DeFlow/ledger. @DeFlow/core declares the Db port; it never opens a database."
              },
              {
                "name": "execa",
                "message": "Spawning belongs in @DeFlow/adapters or @DeFlow/daemon. @DeFlow/core is deterministic and has no subprocesses."
              },
              {
                "name": "hono",
                "message": "HTTP belongs in @DeFlow/daemon. @DeFlow/core is transport-agnostic."
              },
              {
                "name": "pino",
                "message": "Logging is a driver. @DeFlow/core returns values; the daemon decides what to write."
              },
              {
                "name": "ajv",
                "message": "The Ajv validator lives in @DeFlow/daemon (src/schema-store.ts) and in packages/core/scripts. @DeFlow/core owns the Zod source of truth and the pure conversion only."
              },
              {
                "name": "ajv-formats",
                "message": "The Ajv validator lives in @DeFlow/daemon (src/schema-store.ts) and in packages/core/scripts. @DeFlow/core owns the Zod source of truth and the pure conversion only."
              },
              {
                "name": "@modelcontextprotocol/sdk",
                "message": "The MCP host belongs in @DeFlow/daemon."
              },
              {
                "name": "@agentclientprotocol/sdk",
                "message": "The ACP client belongs in @DeFlow/adapters."
              },
              {
                "name": "@lydell/node-pty",
                "message": "Terminals belong in @DeFlow/daemon, behind an optional dependency."
              }
            ]
          }
        ]
      }
    },
    {
      // Specs are not the published surface, and a spec that parses a fixture
      // needs node:fs. The purity guard scopes itself the same way
      // (`productionSources` skips *.test.ts), so the two agree on what "core
      // is pure" means. A later override wins, as it does in ESLint.
      "files": ["packages/core/src/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "vitest.config.ts",
    "packages/web/**",
    "packages/mock-agent/**",
    "packages/testkit/**",
    "e2e/**",
    "test/**",
    ".claude/**",
    // Every packages/*/tsconfig.json sets "include": ["src"] (testkit adds
    // "bin") — test/ directories are outside every project's type-checked
    // graph, "pnpm typecheck" never sees them, and --type-aware's tsconfig
    // auto-discovery falls back to weaker defaults for a file that config
    // does not "include", producing both false positives and false negatives
    // rather than the real project's strict settings. Scoping type-aware
    // linting to what is actually typechecked keeps its diagnostics honest;
    // widening this needs test/ added to a tsconfig's "include" first.
    "packages/*/test/**",
    // Same rule, same evidence. EPIC-00 puts every spike directory outside the
    // workspace globs on purpose — "so it never enters `pnpm -r` or the
    // typecheck graph" — so no tsconfig "include" covers spikes/** either, and
    // --type-aware falls back to the same weaker defaults. Pointed at
    // spikes/s1-acp it reports, among other things, an "unnecessary optional
    // chain" on an indexed access, which is only unnecessary when
    // noUncheckedIndexedAccess is off; tsconfig.base.json has it on.
    // Diagnostics derived from settings this project does not use are noise.
    // Spike directories are deleted or archived when EPIC-01 starts anyway.
    "spikes/**"
  ]
}
