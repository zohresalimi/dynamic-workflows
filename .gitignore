node_modules/
dist/
coverage/
*.tgz
*.log
.DS_Store
.env
.env.*
*.local
*.tsbuildinfo

# SQLite's WAL sidecars. The committed fixture ledgers are the .db files; the
# -wal and -shm beside them are created by whichever process last opened one
# and are never part of the fixture.
*.db-wal
*.db-shm

# Vitest browser mode writes a PNG for a failing spec, in one of two places
# depending on how it was run. Useful locally, never a repository artefact.
__screenshots__/
.vitest-attachments/

# A run's own data directory, and local tool scratch. Neither is ever the
# repository's: they hold ledgers, blobs and machine-local paths.
.DeFlow/
.claude/

# The built SPA, where DeFlowd resolves it to when run from source. It is a
# build output that happens to land under src/ because `./ui/` relative to the
# server module is `dist/ui` in the published tarball and this from the
# repository (packages/daemon/src/http/server.ts). e2e/ui-bootstrap.test.ts
# writes it and removes it again.
packages/daemon/src/http/ui/
