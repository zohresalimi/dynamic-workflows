{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflow.dev/schemas/mock-scenario.v1.json",
  "title": "DeFlow mock agent scenario",
  "description": "A whole agent turn as data. The binary carries its own hand-written parser because @DeFlow/mock-agent ships exactly one dependency and ajv is not it; this schema is the format's published contract, and a unit test keeps the two readers from drifting.",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "stopReason": { "$ref": "#/$defs/stopReason" },
    "steps": {
      "type": "array",
      "description": "Executed in order. The first step that declares a stopReason ends the turn.",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "stopReason": {
      "type": "string",
      "enum": ["end_turn", "max_tokens", "max_turn_requests", "refusal", "cancelled"]
    },
    "toolKind": {
      "type": "string",
      "enum": [
        "read",
        "edit",
        "delete",
        "move",
        "search",
        "execute",
        "think",
        "fetch",
        "switch_mode",
        "other"
      ]
    },
    "toolCallStatus": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed"]
    },
    "clientMethod": {
      "type": "string",
      "description": "The seven client methods ACP v1 defines. ACP v2 removes all seven and pushes them onto MCP.",
      "enum": [
        "fs/read_text_file",
        "fs/write_text_file",
        "terminal/create",
        "terminal/output",
        "terminal/wait_for_exit",
        "terminal/kill",
        "terminal/release"
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where control goes after a decision. Omitting stopReason means 'carry on with the rest of the script'.",
      "properties": {
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "stopReason": { "$ref": "#/$defs/stopReason" }
      }
    },
    "step": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/planStep" },
        { "$ref": "#/$defs/chunksStep" },
        { "$ref": "#/$defs/messageStep" },
        { "$ref": "#/$defs/toolCallStep" },
        { "$ref": "#/$defs/permissionStep" },
        { "$ref": "#/$defs/clientCallStep" },
        { "$ref": "#/$defs/hangForeverStep" },
        { "$ref": "#/$defs/hangForeverIgnoringCancelStep" },
        { "$ref": "#/$defs/exitStep" },
        { "$ref": "#/$defs/malformedLineStep" },
        { "$ref": "#/$defs/invalidFrameStep" },
        { "$ref": "#/$defs/hugeLineStep" },
        { "$ref": "#/$defs/noNewlineStep" },
        { "$ref": "#/$defs/spawnGrandchildrenStep" }
      ]
    },
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entries"],
      "properties": {
        "type": { "const": "plan" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "content": { "type": "string", "minLength": 1 },
              "priority": { "type": "string", "enum": ["high", "medium", "low"] },
              "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] }
            }
          }
        }
      }
    },
    "chunksStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count"],
      "description": "N agent_message_chunk notifications, delayMs apart. The delay is a real sleep in the child, so keep it in the tens of milliseconds.",
      "properties": {
        "type": { "const": "chunks" },
        "count": { "type": "integer", "minimum": 1 },
        "delayMs": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Pads each chunk to at least this many characters."
        }
      }
    },
    "messageStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "description": "One chunk whose text is exactly what the script says. {{error}} expands to the last client error.",
      "properties": {
        "type": { "const": "message" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "toolCallStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "toolKind", "path", "statuses"],
      "properties": {
        "type": { "const": "toolCall" },
        "title": { "type": "string", "minLength": 1 },
        "toolKind": { "$ref": "#/$defs/toolKind" },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "The ToolCallLocation carried on every frame. Required: it is what lets a permission ladder enforce path scope at request time rather than detect a violation afterwards."
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/toolCallStatus" }
        },
        "delayMs": { "type": "integer", "minimum": 0 }
      }
    },
    "permissionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "toolKind", "path", "options"],
      "properties": {
        "type": { "const": "permission" },
        "title": { "type": "string", "minLength": 1 },
        "toolKind": { "$ref": "#/$defs/toolKind" },
        "path": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["optionId", "name", "kind"],
            "properties": {
              "optionId": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": ["allow_once", "allow_always", "reject_once", "reject_always"]
              }
            }
          }
        },
        "onAllowed": { "$ref": "#/$defs/branch" },
        "onRejected": { "$ref": "#/$defs/branch" },
        "onCancelled": {
          "$ref": "#/$defs/branch",
          "description": "Taken for { outcome: 'cancelled' }, which carries no optionId. An agent that ignores this variant deadlocks the node."
        }
      }
    },
    "clientCallStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "method"],
      "properties": {
        "type": { "const": "clientCall" },
        "method": { "$ref": "#/$defs/clientMethod" },
        "params": {
          "type": "object",
          "description": "Merged over sessionId, and over terminalId when a terminal has been created."
        },
        "onError": { "$ref": "#/$defs/branch" }
      }
    },
    "hangForeverStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "Stop emitting and stay: no further byte, no exit, and stdout left open, so the client observes a wedge rather than an EOF.",
      "properties": {
        "type": { "const": "hangForever" },
        "onCancel": {
          "$ref": "#/$defs/branch",
          "description": "What session/cancel triggers. Defaults to { steps: [], stopReason: 'cancelled' } — adapter layer §2.5 stage 1 answers the prompt rather than tearing the session down."
        }
      }
    },
    "hangForeverIgnoringCancelStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "The same wedge, deaf to session/cancel. This is the state the SIGTERM escalation in KAR-05.9 has to resolve.",
      "properties": { "type": { "const": "hangForeverIgnoringCancel" } }
    },
    "exitStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "process.exit mid-turn. Place it BEFORE the steps it interrupts: afterFrames counts notifications from where this step runs.",
      "properties": {
        "type": { "const": "exit" },
        "code": { "type": "integer", "minimum": 0, "description": "Exit code. Default 1." },
        "afterFrames": {
          "type": "integer",
          "minimum": 0,
          "description": "Notifications to allow through first. 0 exits immediately. Default 0."
        },
        "truncateMidFrame": {
          "type": "boolean",
          "description": "Leave a half-written frame with no trailing newline. This is what separates agent.nonzero-exit from adapter.malformed-output. Default false."
        }
      }
    },
    "malformedLineStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "A complete line that is not JSON at all. The input for a NodeFailure with reason adapter.malformed-output.",
      "properties": {
        "type": { "const": "malformedLine" },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The line, without its newline. Defaults to an unbalanced brace cut at a key."
        }
      }
    },
    "invalidFrameStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "Syntactically valid JSON that fails validation against @agentclientprotocol/sdk/schema/schema.json. The input for adapter.protocol-error, which is a different reason from adapter.malformed-output.",
      "properties": {
        "type": { "const": "invalidFrame" },
        "variant": {
          "type": "string",
          "enum": [
            "unknownSessionUpdate",
            "toolCallMissingId",
            "unknownPermissionOptionKind",
            "unknownStopReason",
            "locationPathNotAString"
          ]
        }
      }
    },
    "hugeLineStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "One line of totalBytes with no embedded newline, written chunkBytes at a time so a byte counter sees it grow. The payload is a generated repeating pattern, never random and never checked in.",
      "properties": {
        "type": { "const": "hugeLine" },
        "totalBytes": { "type": "integer", "minimum": 1, "description": "Default 10485760." },
        "chunkBytes": { "type": "integer", "minimum": 1, "description": "Default 65536." }
      }
    },
    "noNewlineStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "The same flood with no 0x0a, ever. The SDK's LineBuffer has no maximum line length, so left alone it accumulates without emitting a frame.",
      "properties": {
        "type": { "const": "noNewline" },
        "chunkBytes": { "type": "integer", "minimum": 1, "description": "Default 65536." },
        "intervalMs": { "type": "integer", "minimum": 0, "description": "Default 10." },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Omit to flood without end, which is the hazard itself."
        }
      }
    },
    "spawnGrandchildrenStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "Processes that outlive the agent, announced on the wire as 'grandchildren: <pid>,<pid>'. They stay in the agent's process group, so the orphan reaper has something to find.",
      "properties": {
        "type": { "const": "spawnGrandchildren" },
        "count": { "type": "integer", "minimum": 1, "description": "Default 2." },
        "lifetimeMs": { "type": "integer", "minimum": 1, "description": "Default 30000." }
      }
    }
  }
}
