{
  "$schema": "../schema/mock-scenario.v1.json",
  "name": "exit-with-grandchildren",
  "description": "EPIC-04-S9: two processes that outlive the agent, then a nonzero exit. They are reparented to pid 1 while their pgid stays the dead agent's pid — the row the orphan reaper in KAR-05.9 must find in SQLite on the next daemon boot.",
  "steps": [
    { "type": "spawnGrandchildren", "count": 2, "lifetimeMs": 30000 },
    { "type": "exit", "code": 1, "afterFrames": 0, "truncateMidFrame": false }
  ],
  "stopReason": "end_turn"
}
