{
  "$schema": "../schema/mock-scenario.v1.json",
  "name": "hang-forever",
  "description": "EPIC-04-S8: two chunks, then a wedge. Nothing more is written and nothing is closed, so the client observes a hang rather than an EOF. A session/cancel flushes the two declared trailing updates and ends the turn with stopReason cancelled, which is stage 1 of the three-stage cancellation in adapter layer §2.5.",
  "steps": [
    { "type": "chunks", "count": 2, "delayMs": 0, "text": "before the wedge" },
    {
      "type": "hangForever",
      "onCancel": {
        // The tail a client that tore its reader down on cancel would lose.
        "steps": [
          { "type": "message", "text": "flushing tail 1" },
          { "type": "message", "text": "flushing tail 2" }
        ],
        "stopReason": "cancelled"
      }
    }
  ],
  "stopReason": "end_turn"
}
