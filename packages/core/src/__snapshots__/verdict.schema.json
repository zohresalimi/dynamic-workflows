{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflow.dev/schemas/DeFlow.verdict.v3.json",
  "title": "DeFlow.verdict.v3",
  "description": "The gate contract: outcome, per-criterion status, blob-anchored findings and what the verdict cost — the one shape a deterministic gate and an adversarial reviewer both return (F7.3, F6.9, F7.7).",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "pattern": "^[A-Za-z][\\w.-]*\\.v\\d+$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "needs-human"
      ]
    },
    "gate": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "evaluatedNode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "by": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node",
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "unsatisfied",
              "unverifiable"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "info"
            ]
          },
          "criterion": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "blobSha": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            },
            "required": [
              "file",
              "line",
              "blobSha"
            ],
            "additionalProperties": false
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggestedFix": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "message",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "specHash": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "cost": {
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cacheReadInputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cacheCreationInputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoningOutputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source": {
              "type": "string",
              "enum": [
                "vendor-reported",
                "estimated"
              ]
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "source"
          ],
          "additionalProperties": false
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "durationMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaId",
    "outcome",
    "gate",
    "evaluatedNode",
    "by",
    "criteria",
    "findings",
    "summary"
  ],
  "additionalProperties": false
}
